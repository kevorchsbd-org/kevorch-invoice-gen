rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Security Helper Function
    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profile Document Security
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Business Billing Collections (Protected: Authenticated Users Only)
    match /clients/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /quotations/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /invoices/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /balanceInvoices/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /payments/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /documents/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /files/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /activityLogs/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /emailLogs/{documentId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{documentId} {
      allow read, write: if isAuthenticated();
    }
  }
}
